[0.065, "o", "\u001b[1;93H\u001b[0;30;40;1m \u001b[1;94HQ\u001b[1;95H\u001b[0;37;40m=\u001b[1;96H\u001b[0;30;40;1mQ\u001b[1;97HX\u001b[1;100H\u001b[0;37;40m|\u001b[2;93H_\u001b[2;94H\u001b[0;30;40;1mQ\u001b[2;95H\u001b[0;37;40m+\u001b[2;96H\u001b[0;30;40;1mQ\u001b[2;97HX\u001b[2;99H\u001b[0;37;40m=\u001b[3;93H\u001b[0;30;40;1m \u001b[3;94H \u001b[3;95H \u001b[3;96H \u001b[3;97HQ\u001b[3;98H\u001b[0;37;40m=\u001b[3;99H_\u001b[3;100H|\u001b[4;92H_\u001b[4;93H`\u001b[4;95H,\u001b[4;96H_\u001b[4;97H=\u001b[4;98H|\u001b[4;99H(\u001b[4;100H,\u001b[5;91H\u001b[0;30;40;1m:\u001b[5;92H\u001b[0;37;40m_\u001b[5;93H\u001b[0;30;40;1m \u001b[5;94H\u001b[0;37;40m+\u001b[5;95H+\u001b[5;96H_\u001b[5;98H\u001b[0;37;40;1m.\u001b[5;99H.\u001b[5;100H\u001b[0;37;40m%\u001b[6;91H\u001b[0;37;40;1m.\u001b[6;92H\u001b[0;37;40m+\u001b[6;93H\u001b[0;30;40;1mW\u001b[6;94HX\u001b[6;95HQ\u001b[6;96H\u001b[0;37;40m=\u001b[6;100Hn\u001b[7;89H\u001b[0;30;40;1m \u001b[7;90H\u001b[0;37;40;1m.\u001b[7;91H\u001b[0;37;40m,\u001b[7;92H_\u001b[7;93H\u001b[0;30;40;1mQ\u001b[7;94H\u001b[0;37;40m=\u001b[7;95H`\u001b[7;96Hi\u001b[7;97Hl\u001b[7;99Hv\u001b[7;100HI\u001b[8;89H_\u001b[8;90H/\u001b[8;91H\u001b[0;30;40;1mv\u001b[8;92H#\u001b[8;93H\u001b[0;37;40m_\u001b[8;94Hl\u001b[8;95H\u001b[0;37;40;1m:\u001b[8;96H\u001b[0;37;40mI\u001b[8;99Hv\u001b[8;100Hl\u001b[9;89H\u001b[0;30;40;1m \u001b[9;90H\u001b[0;37;40m=\u001b[9;91H,\u001b[9;92H_\u001b[9;93Hv\u001b[9;94Hl\u001b[9;98Hv\u001b[9;100HI\u001b[10;85H\u001b[0;30;40;1m:\u001b[10;86HI\u001b[10;87H\u001b[0;37;40m|\u001b[10;88H+\u001b[10;89H=\u001b[10;90H\u001b[0;37;40;1m.\u001b[10;91H:\u001b[10;93H\u001b[0;37;40mv\u001b[10;99Hl\u001b[10;100Hl\u001b[11;84H,\u001b[11;85H\u001b[0;30;40;1mQ\u001b[11;86H\u001b[0;37;40m:\u001b[11;87H+\u001b[11;88H\u001b[0;37;40;1m.\u001b[11;90H\u001b[0;37;40mv\u001b[11;95Hv\u001b[11;97HI\u001b[11;99HI\u001b[11;100H\u001b[0;37;40;1m:\u001b[12;81H\u001b[0;37;40m,\u001b[12;82H/\u001b[12;83H\u001b[0;30;40;1mQ\u001b[12;84H\u001b[0;37;40m+\u