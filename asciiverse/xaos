#!/bin/sh
# Starts XaoS. It finds its help, tutorials, examples and tutorial texts
# beside the binary it was started as, so it is started by its full path:
# lib/ beside this script in an av install, /usr/lib/xaos in a system
# package. It saves positions, animations and images in the folder it runs
# in: the folder you start it from, or your home folder when that is the
# install folder (av starts titles there), so nothing saved is lost when
# XaoS is uninstalled.
# av links ~/.local/bin/xaos to this file, so follow that link first.
self=$(readlink "$0" 2>/dev/null || printf '%s' "$0")
case "$self" in /*) ;; *) self="$(dirname "$0")/$self" ;; esac
dir=$(cd "$(dirname "$self")" && pwd)
if [ "$(pwd -P)" = "$(cd "$dir" && pwd -P)" ] && [ -n "${HOME:-}" ]; then
	cd "$HOME" || exit 1
fi
if [ -x "$dir/lib/xaos" ]; then
	exec "$dir/lib/xaos" "$@"
fi
exec /usr/lib/xaos/xaos "$@"
