; The catalog preview (asciiverse/record-preview.py): the whole set, a dive
; into Elephant Valley and back, then a Julia set morphing from the one
; at -0.75+0.11i to Douady's rabbit, with colour cycling at the end.
(initstate)
(defaultpalette 0)
(formula 'mandel)
(maxiter 170)
(view -0.75 0 2.6 2.6)
(morphview -0.75 0 2.5 2.5)
(usleep 2500000)
(morphview 0.30 0.02 0.035 0.035)
(usleep 6500000)
(usleep 1500000)
(morphview -0.75 0 2.5 2.5)
(usleep 2500000)
(juliaseed -0.75 0.11)
(julia #t)
(view 0 0 3.2 3.2)
(display)
(usleep 1500000)
(morphjulia -0.123 0.745)
(usleep 6000000)
(cycling #t)
(usleep 3500000)
